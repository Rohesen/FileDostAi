# Copy this file to .env next to docker-compose.yml and fill it in.
# Never upload .env to GitHub: the tunnel token is a password.

# Your domain without https:// or www, for example filedost.in
DOMAIN=REPLACE_ME.com

# From Cloudflare: Zero Trust > Networks > Tunnels > your tunnel > the long code after "--token"
TUNNEL_TOKEN=REPLACE_ME
